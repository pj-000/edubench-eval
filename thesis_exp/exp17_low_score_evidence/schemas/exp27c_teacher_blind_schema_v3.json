{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exp27C Teacher Blind Annotation V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "blind"],
  "properties": {
    "sample_id": {"type": "string"},
    "blind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teacher_score",
        "teacher_reason",
        "major_failures",
        "evidence_span",
        "evidence_type",
        "missing_evidence_reason",
        "rubric_clause",
        "rubric_fit",
        "score_cap",
        "score_region",
        "failure_visibility",
        "overestimation_risk",
        "answer_key_uncertainty",
        "confidence",
        "needs_human_review_blind",
        "uncertainty_reason"
      ],
      "properties": {
        "teacher_score": {"type": "integer", "minimum": 1, "maximum": 5},
        "teacher_reason": {"type": "string"},
        "major_failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "missing_key_point",
              "missing_personalization",
              "missing_scenario_integration",
              "rubric_mismatch",
              "factual_error",
              "insufficient_reasoning",
              "insufficient_evidence",
              "partial_or_incomplete",
              "task_constraint_violation",
              "format_violation",
              "irrelevant_or_off_topic",
              "unsupported_claim",
              "no_major_failure",
              "unclear"
            ]
          }
        },
        "evidence_span": {"type": ["string", "null"]},
        "evidence_type": {
          "type": "string",
          "enum": [
            "verbatim_answer_span",
            "missing_required_content",
            "rubric_mismatch",
            "insufficient_context",
            "not_applicable",
            "unclear"
          ]
        },
        "missing_evidence_reason": {
          "type": ["string", "null"],
          "enum": [
            "missing_reasoning",
            "missing_key_point",
            "missing_personalization",
            "missing_scenario_integration",
            "missing_explanation",
            "missing_required_format",
            null
          ]
        },
        "rubric_clause": {"type": ["string", "null"]},
        "rubric_fit": {
          "type": "string",
          "enum": [
            "fully_matches",
            "mostly_matches",
            "partially_matches",
            "weakly_matches",
            "does_not_match",
            "unclear"
          ]
        },
        "score_cap": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "score_region": {"type": "string", "enum": ["low", "mid", "high"]},
        "failure_visibility": {
          "type": "string",
          "enum": [
            "explicit_failure",
            "hidden_failure",
            "missing_required_content",
            "no_major_failure",
            "unclear"
          ]
        },
        "overestimation_risk": {"type": "string", "enum": ["high", "medium", "low", "unclear"]},
        "answer_key_uncertainty": {
          "type": "string",
          "enum": [
            "none",
            "possible_answer_key_issue",
            "insufficient_reference",
            "rubric_ambiguous",
            "unclear"
          ]
        },
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "needs_human_review_blind": {"type": "boolean"},
        "uncertainty_reason": {"type": ["string", "null"]}
      }
    }
  }
}
