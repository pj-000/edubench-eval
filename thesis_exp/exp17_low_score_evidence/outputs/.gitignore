*
!.gitignore

# Global guardrails for Exp17/Exp19 generated raw artifacts. Lightweight
# reports/tables/configs are explicitly re-included by experiment blocks below.
**/data/*.json
**/predictions/*.jsonl
**/raw_generations/**
**/logs/**
**/predict_logs/**

!exp19_sft_dpo_datasets_seed42/
exp19_sft_dpo_datasets_seed42/data/
!exp19_sft_dpo_datasets_seed42/configs/
!exp19_sft_dpo_datasets_seed42/configs/**
!exp19_sft_dpo_datasets_seed42/dataset_info.json
!exp19_sft_dpo_datasets_seed42/dataset_info_snippet.json
!exp19_sft_dpo_datasets_seed42/redacted_samples/
!exp19_sft_dpo_datasets_seed42/redacted_samples/**
!exp19_sft_dpo_datasets_seed42/reports/
!exp19_sft_dpo_datasets_seed42/reports/**
!exp19_sft_dpo_datasets_seed42/tables/
!exp19_sft_dpo_datasets_seed42/tables/**

# Exp19 first-round SFT evaluation keeps raw model outputs/logs local, while
# allowing lightweight summary tables/reports to be reviewed.
!exp19_sft_first_round/
exp19_sft_first_round/*
!exp19_sft_first_round/reports/
!exp19_sft_first_round/reports/**
!exp19_sft_first_round/tables/
!exp19_sft_first_round/tables/**
!exp19_sft_first_round/decision/
!exp19_sft_first_round/decision/**

# Exp19 second-round SFT keeps logs/checkpoints/adapters local/server-side, while
# allowing lightweight training summaries to be reviewed.
!exp19_sft_second_round/
exp19_sft_second_round/*
!exp19_sft_second_round/reports/
!exp19_sft_second_round/reports/**
!exp19_sft_second_round/tables/
!exp19_sft_second_round/tables/**
!exp19_sft_second_round/decision/
!exp19_sft_second_round/decision/**

# Exp19-SFT-D2 keeps prompt subsets, raw predictions, logs, and configs local,
# while allowing lightweight diagnostic summaries to be reviewed.
!exp19_sft_train_dev_diagnostics_seed42/
exp19_sft_train_dev_diagnostics_seed42/*
!exp19_sft_train_dev_diagnostics_seed42/reports/
!exp19_sft_train_dev_diagnostics_seed42/reports/**
!exp19_sft_train_dev_diagnostics_seed42/tables/
!exp19_sft_train_dev_diagnostics_seed42/tables/**
!exp19_sft_train_dev_diagnostics_seed42/decision/
!exp19_sft_train_dev_diagnostics_seed42/decision/**

# Exp19-R5A is a risk-balanced synthetic-template DPO scout. It keeps full DPO
# JSON local/server-side, while allowing lightweight QC tables, configs,
# reports, and redacted samples to be reviewed.
!exp19_r5a_onpolicy_dpo_seed42/
exp19_r5a_onpolicy_dpo_seed42/*
!exp19_r5a_onpolicy_dpo_seed42/configs/
!exp19_r5a_onpolicy_dpo_seed42/configs/**
!exp19_r5a_onpolicy_dpo_seed42/dataset_info_r5a_snippet.json
!exp19_r5a_onpolicy_dpo_seed42/redacted_samples/
!exp19_r5a_onpolicy_dpo_seed42/redacted_samples/**
!exp19_r5a_onpolicy_dpo_seed42/reports/
!exp19_r5a_onpolicy_dpo_seed42/reports/**
!exp19_r5a_onpolicy_dpo_seed42/tables/
!exp19_r5a_onpolicy_dpo_seed42/tables/**

# Exp19-R5B keeps full rejection-mined DPO JSON local/server-side, while
# allowing lightweight QC tables, configs, reports, and redacted samples.
!exp19_r5b_rejection_mined_dpo_seed42/
exp19_r5b_rejection_mined_dpo_seed42/*
!exp19_r5b_rejection_mined_dpo_seed42/configs/
!exp19_r5b_rejection_mined_dpo_seed42/configs/**
!exp19_r5b_rejection_mined_dpo_seed42/dataset_info_r5b_snippet.json
!exp19_r5b_rejection_mined_dpo_seed42/redacted_samples/
!exp19_r5b_rejection_mined_dpo_seed42/redacted_samples/**
!exp19_r5b_rejection_mined_dpo_seed42/reports/
!exp19_r5b_rejection_mined_dpo_seed42/reports/**
!exp19_r5b_rejection_mined_dpo_seed42/tables/
!exp19_r5b_rejection_mined_dpo_seed42/tables/**

# Exp19-R5C/R5D/R5E keep full DPO JSON local/server-side, while allowing
