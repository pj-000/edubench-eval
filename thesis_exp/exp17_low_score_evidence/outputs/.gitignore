!exp19_r5d_evidence_consistency_dpo_seed42/
exp19_r5d_evidence_consistency_dpo_seed42/*
!exp19_r5d_evidence_consistency_dpo_seed42/configs/
!exp19_r5d_evidence_consistency_dpo_seed42/configs/**
