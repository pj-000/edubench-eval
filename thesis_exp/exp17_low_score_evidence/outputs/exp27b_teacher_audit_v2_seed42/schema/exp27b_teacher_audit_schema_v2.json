{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exp27B Teacher Label Audit V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "blind", "audit"],
  "properties": {
    "sample_id": {"type": "string"},
    "blind": {
      "$ref": "exp27b_teacher_blind_schema_v2.json#/properties/blind"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_score",
        "teacher_score",
        "score_agreement",
        "label_quality",
        "label_noise_type",
        "recommended_training_use",
        "sample_weight_suggestion",
        "needs_human_review",
        "audit_reason"
      ],
      "properties": {
        "original_score": {"type": "integer", "minimum": 1, "maximum": 5},
        "teacher_score": {"type": "integer", "minimum": 1, "maximum": 5},
        "score_agreement": {"type": "string", "enum": ["exact", "adjacent", "conflict", "unclear"]},
        "label_quality": {
          "type": "string",
          "enum": ["reliable", "plausible_adjacent", "suspected_conflict", "unclear"]
        },
        "label_noise_type": {
          "type": "string",
          "enum": [
            "none",
            "teacher_stricter_than_human",
            "teacher_more_lenient_than_human",
            "rubric_ambiguity",
            "answer_key_conflict",
            "insufficient_context",
            "annotator_disagreement",
            "unclear"
          ]
        },
        "recommended_training_use": {
          "type": "string",
          "enum": ["high_weight", "low_weight", "review_only", "exclude"]
        },
        "sample_weight_suggestion": {"type": "number", "minimum": 0, "maximum": 3},
        "needs_human_review": {"type": "boolean"},
        "audit_reason": {"type": "string"}
      }
    }
  }
}
