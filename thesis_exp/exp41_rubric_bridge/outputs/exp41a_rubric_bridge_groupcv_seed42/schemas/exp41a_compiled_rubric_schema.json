{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric_unit_id", "target_scope", "criteria", "score_level_rules"],
  "properties": {
    "rubric_unit_id": {"type": "string", "minLength": 1},
    "target_scope": {"const": "rubric_only"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "rubric_quote", "criterion_type", "polarity", "check_question"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
          "rubric_quote": {"type": "string", "minLength": 1},
          "criterion_type": {"enum": ["key_content", "factual_accuracy", "reasoning_support", "relevance_scope", "instruction_format", "scenario_integration", "pedagogical_support", "clarity", "other"]},
          "polarity": {"enum": ["required", "prohibited", "quality"]},
          "check_question": {"type": "string", "minLength": 2}
        }
      }
    },
    "score_level_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score_level", "rubric_quote", "required_criteria"],
        "properties": {
          "score_level": {"type": "integer", "minimum": 1, "maximum": 5},
          "rubric_quote": {"type": "string", "minLength": 1},
          "required_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"}}
        }
      }
    }
  }
}
