{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "source_sample_id", "rubric_clause", "clause_type", "source_evidence_span", "source_span_occurrence", "operator", "target_band", "expected_score_cap_after_edit", "plan_confidence", "plan_reason"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "source_sample_id": {"type": "string", "minLength": 1},
    "rubric_clause": {"type": "string", "minLength": 1},
    "clause_type": {"enum": ["cap_setting", "major", "incremental"]},
    "source_evidence_span": {"type": "string", "minLength": 1},
    "source_span_occurrence": {"type": "integer", "minimum": 0},
    "operator": {"enum": ["delete_required_span", "replace_with_local_contradiction", "delete_supporting_reasoning", "insert_local_scope_drift", "violate_explicit_constraint"]},
    "target_band": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "integer", "minimum": 1, "maximum": 5}
    },
    "expected_score_cap_after_edit": {"type": "integer", "minimum": 1, "maximum": 5},
    "plan_confidence": {"enum": ["high", "medium", "low"]},
    "plan_reason": {"type": "string", "minLength": 1}
  }
}
